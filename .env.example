# Copiá este archivo como ".env.local" y completá con los datos de tu proyecto Firebase
# (Consola de Firebase > Configuración del proyecto > Tus apps > App web > SDK setup).
# Si queda vacío, el sitio funciona igual (sin Firebase) con los valores por defecto.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# "true" para guardar en Firestore cada solicitud de crédito que se envía desde el simulador.
# Por defecto está desactivado.
VITE_SAVE_CREDIT_REQUESTS=false
